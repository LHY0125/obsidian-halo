{
  "name": "obsidian-halo-mcp",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "description": "Halo's Obsidian integration supports publishing content to Halo sites",
  "main": "main.js",
  "scripts": {
    "dev": "rslib build --watch",
    "build": "rslib build",
    "test": "rstest run",
    "test:watch": "rstest watch",
    "test:coverage": "rstest run --coverage",
    "test:contract": "rstest run --include \"tests/contract/**/*.test.ts\"",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "check": "biome check --write src/"
  },
  "author": "Serendipity",
  "maintainers": [
    {
      "name": "Ryan Wang",
      "email": "i@ryanc.cc",
      "url": "https://github.com/ruibaby"
    }
  ],
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@halo-dev/api-client": "^2.25.2",
    "@rslib/core": "^0.23.0",
    "@rstest/core": "^0.10.6",
    "@rstest/coverage-istanbul": "^0.10.6",
    "@types/node": "^24.13.2",
    "obsidian": "latest",
    "tslib": "2.6.0",
    "typescript": "5.1.6"
  },
  "dependencies": {
    "i18next": "^23.16.8",
    "transliteration": "^2.6.1"
  },
  "packageManager": "pnpm@10.34.4",
  "pnpm": {
    "overrides": {
      "@babel/runtime": "^7.26.10"
    }
  }
}
